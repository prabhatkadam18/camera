# Copy this file to .env and fill in your camera details. .env is never committed.

# Main (high-resolution) stream, used for recording.
RTSP_MAIN_URL=rtsp://admin:YOUR_RTSP_PASSWORD@192.168.1.50:554/onvif1

# Sub (low-resolution) stream, used for motion detection in the next step.
RTSP_SUB_URL=rtsp://admin:YOUR_RTSP_PASSWORD@192.168.1.50:554/onvif2

# udp or tcp. Yoosee cameras reject tcp ("Nonmatching transport in server reply").
RTSP_TRANSPORT=udp

# Rolling buffer of short recording chunks. Relative paths are inside this project.
BUFFER_DIR=data/buffer
SEGMENT_SECONDS=10
BUFFER_MINUTES=10

# Motion detection runs on the sub stream (falls back to the main stream if RTSP_SUB_URL is empty).
MOTION_FPS=5
# Share of the image that must change to count as motion (0.005 = 0.5%).
MOTION_MIN_AREA=0.005
# Consecutive frames above MOTION_MIN_AREA needed to start an event (filters single-frame noise).
MOTION_MIN_FRAMES=3
# Seconds without motion before an event ends.
MOTION_END_SECONDS=5
# Whole-frame change above this fraction is treated as lighting/glitch (night-mode IR
# switch, lights), not motion. Raise toward 1.0 to alert on bigger changes too.
MOTION_GLOBAL_LIMIT=0.60
# A single event is force-ended (and a clip emitted) after this many seconds, so one
# long motion becomes a few back-to-back clips instead of one huge file.
MOTION_MAX_EVENT_SECONDS=300
# Areas to ignore, as x,y,width,height fractions of the image, separated by ";".
# The default covers the date/time overlay in the top-left corner.
MOTION_MASKS=0,0,0.42,0.09

# Person/animal detection (second stage of the motion gate). When true, a motion event
# only records if a YOLO model finds a person or animal in frame — ignores lights, shadows,
# headlights, rain. Needs the detection deps (requirements-detect.txt), so leave false on
# the phone; set true on the Raspberry Pi. Degrades to plain motion if the model is missing.
DETECT_ENABLED=false
DETECT_MODEL=yolov8n.pt
DETECT_CONF=0.4

# The cheap camera can only serve ONE stream well — pulling a second stream turns
# the others to noise. So recording AND motion read go2rtc's local restream by
# default (go2rtc does the one camera pull). Leave these BLANK to use that default.
# Only set them to a camera URL if you are NOT running go2rtc.
RECORD_URL=
MOTION_URL=

# Event clips: saved locally then synced to the NAS.
CLIPS_DIR=data/clips
EVENT_PRE_SECONDS=6
EVENT_POST_SECONDS=6
# Retention: keep clips on THIS device (phone) a short while (limited space); the NAS is the
# long-term store. Clips older than the limit are deleted automatically. 0 disables a prune.
CLIP_RETENTION_DAYS=3
NAS_RETENTION_DAYS=30

# Web UI. Set a strong WEB_PASSWORD; blank means nobody can log in.
WEB_PORT=8080
WEB_PASSWORD=
# go2rtc runs locally and is proxied behind the login; leave as-is unless you move it.
GO2RTC_URL=http://127.0.0.1:1984

# NAS storage: rclone remote path for uploading clips, e.g. "nas:camera/clips".
# Blank keeps clips local only. Configure the rclone "nas" SMB remote separately.
NAS_REMOTE=
